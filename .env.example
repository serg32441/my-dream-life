# Supabase Configuration Variables
# Get these values from your Supabase project settings: https://app.supabase.com

# URL of the Supabase instance
REACT_APP_SUPABASE_URL=your_supabase_url_here

# Anon/public key for interacting with Supabase
REACT_APP_SUPABASE_ANON_KEY=your_anonymous_key_here

# Service role key (use with caution - never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Database password
SUPABASE_DB_PASSWORD=your_database_password_here

# Instructions:
# 1. Copy this file to .env (do not commit .env to git)
# 2. Replace the placeholder values with your actual Supabase credentials
# 3. Restart your development server after changing these values
# 4. For React apps, use REACT_APP_ prefix for client-side variables
